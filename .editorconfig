root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csv,cmd,ps1}]
end_of_line = crlf

[*.md]
max_line_length = 120

[*.py]
indent_size = 4
indent_style = space

[*.{css,html,js,json,ts,tsx,yaml,yml}]
indent_size = 2
indent_style = space
